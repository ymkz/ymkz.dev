{
  "name": "ymkz.dev",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "25.9.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port=3000",
    "lint": "biome check",
    "format": "biome check --write",
    "analyze": "fallow dead-code --fail-on-issues --no-cache",
    "update": "pnpm update --latest --interactive",
    "build": "astro build && node scripts/build-resume.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@formepdf/html": "catalog:",
    "astro": "catalog:",
    "fallow": "catalog:",
    "wrangler": "catalog:"
  }
}
