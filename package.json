{
  "name": "ymkz.dev",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "25.9.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port=3000",
    "lint": "biome check",
    "format": "biome check --write",
    "analyze": "knip",
    "update": "pnpm update --latest --interactive",
    "build": "tsx src/resume/build.tsx",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@pdfme/common": "catalog:",
    "@pdfme/generator": "catalog:",
    "@pdfme/jsx": "catalog:",
    "@pdfme/schemas": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
