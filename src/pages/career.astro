---
import Document from "../resume/Document.astro";
import { data } from "../resume/data.mjs";
import Experience from "../resume/Experience.astro";
---
<Document title="職務経歴書">
  <main class="career">
    <div class="career-title"><h1>職務経歴書</h1><p>{data.name}</p></div>
    <h2>職務要約</h2>
    {data.summary.map((paragraph) => <p>{paragraph}</p>)}
    <h2>活かせる経験・知識・技術</h2>
    {data.skills.map((skill) => <p>{skill.label}：{skill.values.join(" / ")}</p>)}
    <h2>職務経歴</h2>
    <h3>{data.company}</h3>
    <p>{data.employment} / {data.role}<br />{data.workplace}</p>
    <Experience items={data.experience.slice(0, 4)} />
    <section class="continued">
      <div class="career-title"><h1>職務経歴書（続き）</h1><p>{data.name}</p></div>
      {data.experience.length > 4 && <>
        <h2>職務経歴（続き）</h2>
        <h3>{data.company}</h3>
        <Experience items={data.experience.slice(4)} />
      </>}
      <h2>就職前の活動</h2>
      <p>{data.earlyCareer.period}</p>
      <p>{data.earlyCareer.description}</p>
      <h2>自己PR</h2>
      <p>{data.strengths}</p>
    </section>
  </main>
</Document>
