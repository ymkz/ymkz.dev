---
import Document from "../resume/Document.astro";
import { data } from "../resume/data.mjs";
---
<Document title="履歴書">
  <main>
    <h1>履歴書</h1>
    <div class="identity">
      <div class="details">
        <div class="name"><p>氏名</p><strong>{data.name}</strong></div>
        <table>
          <tbody>
            <tr><td class="label">生年月日</td><td>{data.birthday}</td></tr>
            <tr><td class="label">現住所</td><td>{data.location}</td></tr>
            <tr><td class="label">Web</td><td>{data.website}</td></tr>
            <tr><td class="label">職種</td><td>{data.role}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="photo"><p>写真<br />縦40mm<br />横30mm</p></div>
    </div>
    <table>
      <thead><tr><th class="year">年</th><th class="month">月</th><th>学歴・職歴</th></tr></thead>
      <tbody>
        <tr><td></td><td></td><td>学歴</td></tr>
        {data.education.map((item) => (
          <tr><td>{item.period.split("/")[0]}</td><td>{item.period.split("/")[1]}</td><td>{item.description}</td></tr>
        ))}
        <tr><td></td><td></td><td>職歴</td></tr>
        <tr>
          <td>{data.employment.split(" ")[0].split("/")[0]}</td>
          <td>{data.employment.split(" ")[0].split("/")[1]}</td>
          <td>{data.company} 入社</td>
        </tr>
        <tr><td></td><td></td><td>{data.employment}<br />{data.role}として勤務</td></tr>
        <tr><td></td><td></td><td>現在に至る（詳細は別紙職務経歴書に記載）</td></tr>
        <tr><td></td><td></td><td>以上</td></tr>
      </tbody>
    </table>
    <table>
      <thead><tr><th>免許・資格</th></tr></thead>
      <tbody>{data.qualifications.map((item) => <tr><td>{item}</td></tr>)}</tbody>
    </table>
    <section class="frame"><h2>自己PR</h2><p>{data.strengths}</p></section>
    <section class="frame"><h2>受賞歴</h2><p>{data.award}</p></section>
  </main>
</Document>
