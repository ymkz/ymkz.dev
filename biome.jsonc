{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "public/**",
      ".github/**",
      ".vscode/**",
      "biome.jsonc",
      "package.json",
      "pnpm-workspace.yaml",
      "wrangler.jsonc"
    ]
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  }
}
